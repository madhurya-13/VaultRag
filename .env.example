# Copy to .env. Generate unique random values; do not reuse these examples.
# Safe alphanumeric secrets avoid URL-encoding problems in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ALPHANUMERIC_SECRET
MIGRATOR_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_ALPHANUMERIC_SECRET
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS_LONG

ENVIRONMENT=production
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_HOST=localhost
WEB_PORT=3000
OLLAMA_MODEL=qwen2.5:3b
LOG_LEVEL=INFO
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
MAX_PDF_PAGES=1000
