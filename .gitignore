# ---------------------------------------------------------------------------
# Secrets - never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.locust-users.csv
*.pem
*.key
*.p12

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Editors / operating system
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Runtime artefacts
# ---------------------------------------------------------------------------
*.log
logs/
*.sqlite3
pgdata/
database/dumps/

# ---------------------------------------------------------------------------
# Private uploaded documents
# ---------------------------------------------------------------------------
# Local private storage must never be committed or served by a web server.
private_documents/
backend/private_documents/

# Test storage is normally created under the OS temp directory, but keep these
# patterns here for local runs that use a repository-relative path.
test-documents/
vaultrag-test-documents-*/
