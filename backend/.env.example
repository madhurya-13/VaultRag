# ---------------------------------------------------------------------------
# VaultRAG environment configuration
# Copy this file to backend/.env and replace every value marked CHANGE_ME.
# NEVER commit backend/.env to Git.
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development

# PostgreSQL connection string (SQLAlchemy + psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://vaultrag:vaultrag_local_dev_password@localhost:5432/vaultrag

# Used only by pytest. The test suite TRUNCATES this database.
TEST_DATABASE_URL=postgresql+psycopg://vaultrag:vaultrag_local_dev_password@localhost:5432/vaultrag_test

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters. Production startup refuses placeholder values.
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_secret_with_at_least_32_characters

# HS256 | HS384 | HS512. Keep HS256 unless you have a reason to change it.
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes (1 - 1440).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call the API. JSON array. Empty is safest for now.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# SQL logging (never enable in production).
SQL_ECHO=false
LOG_LEVEL=INFO
