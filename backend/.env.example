# ---------------------------------------------------------------------------
# VaultRAG environment configuration
# Copy this file to backend/.env and replace every value marked CHANGE_ME.
# NEVER commit backend/.env to Git.
# ---------------------------------------------------------------------------
#
# Database roles are separate on purpose:
#   vaultrag_app       runtime API role. NOSUPERUSER, NOBYPASSRLS, no DDL.
#   vaultrag_migrator  Alembic/schema owner. NOSUPERUSER, NOBYPASSRLS.
#
# Create both roles before running Alembic:
#   psql -v app_password='...' -v migrator_password='...' \
#        -d vaultrag -f database/bootstrap_roles.sql
#   psql -v app_password='...' -v migrator_password='...' \
#        -d vaultrag_test -f database/bootstrap_roles.sql
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development

# Runtime API connection (restricted role).
DATABASE_URL=postgresql+psycopg://vaultrag_app:CHANGE_ME_APP_PASSWORD@localhost:5432/vaultrag

# DDL-capable connection used by Alembic (schema-owner role).
MIGRATION_DATABASE_URL=postgresql+psycopg://vaultrag_migrator:CHANGE_ME_MIGRATOR_PASSWORD@localhost:5432/vaultrag

# Used only by pytest. The test suite DROPS and TRUNCATES this database.
TEST_DATABASE_URL=postgresql+psycopg://vaultrag_app:CHANGE_ME_APP_PASSWORD@localhost:5432/vaultrag_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://vaultrag_migrator:CHANGE_ME_MIGRATOR_PASSWORD@localhost:5432/vaultrag_test

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters. Production startup refuses placeholder values.
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_secret_with_at_least_32_characters

# HS256 | HS384 | HS512. Keep HS256 unless you have a reason to change it.
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes (1 - 1440).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call the API. JSON array. Empty is safest for now.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# SQL logging (never enable in production).
SQL_ECHO=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Milestone 3: private storage and ingestion
# ---------------------------------------------------------------------------
# Private local storage root. Never place this below a public/static directory
# and never configure a web server to serve it.
DOCUMENT_STORAGE_DIR=private_documents

# Maximum accepted PDF size while streaming (25 MiB).
MAX_UPLOAD_SIZE_BYTES=26214400

# Local Sentence Transformers model. No external embedding API is called.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=main
# Must remain 384 because document_chunks.embedding is VECTOR(384).
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# Token-aware chunking. Invariants:
#   CHUNK_MIN_TOKENS <= CHUNK_SIZE_TOKENS <= CHUNK_MAX_TOKENS
#   CHUNK_OVERLAP_TOKENS < CHUNK_SIZE_TOKENS
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=50
CHUNK_MAX_TOKENS=700

# PDFs with fewer non-whitespace characters are treated as image-only and
# rejected because OCR is not implemented in this milestone.
PDF_MIN_EXTRACTABLE_CHARS=50

# ---------------------------------------------------------------------------
# Milestone 4: permission-aware RAG and local Ollama generation
# ---------------------------------------------------------------------------
# Candidate chunks retrieved before authorization. Default 10, maximum 50.
RAG_TOP_K_DEFAULT=10
RAG_TOP_K_MAX=50
# Fully authorized chunks sent to context construction after reranking.
RAG_CONTEXT_TOP_N=5
# Cosine-similarity gate. This is a policy threshold, not a probability.
RAG_MIN_SIMILARITY=0.20
RAG_MAX_QUESTION_CHARS=4000
RAG_MAX_CONTEXT_TOKENS=3000
# Optional local cross-encoder. Disabled by default.
RAG_RERANK_ENABLED=false
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Local Ollama instance. No paid API key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_OUTPUT_TOKENS=512
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_HEALTH_TIMEOUT_SECONDS=2
OLLAMA_MODEL_CACHE_SECONDS=30
